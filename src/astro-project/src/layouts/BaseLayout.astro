---
import '@theme/styles/global.css'
import '@user-style'
import blogConfig from 'virtual:blog-config'
import { buildLayoutMeta } from '../lib/layout-meta.ts'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  type?: 'website' | 'article'
  publishedTime?: string
  modifiedTime?: string
  authors?: string[]
  tags?: string[]
  lang?: string
  alternateLanguages?: Record<string, string>
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean
  /** Absolute canonical URL that overrides the page's own URL (republished posts). */
  canonical?: string
}

const {
  title = blogConfig.name,
  description = blogConfig.description,
  ogImage = blogConfig.seo?.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  authors = [],
  tags = [],
  lang = blogConfig.defaultLanguage,
  alternateLanguages = {},
  noindex = false,
  canonical,
} = Astro.props
const basePrefix = blogConfig.basePath === '/' ? '' : blogConfig.basePath
const favicon = blogConfig.favicon

const siteUrl = blogConfig.siteUrl
const meta = buildLayoutMeta({
  config: blogConfig,
  siteUrl,
  pathname: Astro.url.pathname,
  title,
  description,
  ogImage,
  type,
  publishedTime,
  modifiedTime,
  authors,
  tags,
  lang,
  alternateLanguages,
  noindex,
  canonical,
})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {blogConfig.seo?.keywords && (
      <meta name="keywords" content={blogConfig.seo.keywords.join(', ')} />
    )}
    {noindex && <meta name="robots" content="noindex" />}

    {/* Open Graph */}
    {meta.resolvedOgImage && <meta property="og:image" content={meta.resolvedOgImage} />}
    <meta property="og:title" content={meta.pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    {meta.canonicalUrl && <meta property="og:url" content={meta.canonicalUrl} />}
    <meta property="og:site_name" content={blogConfig.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {meta.ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {meta.resolvedOgImage && <meta name="twitter:image" content={meta.resolvedOgImage} />}

    {/* Canonical URL */}
    {meta.canonicalUrl && <link rel="canonical" href={meta.canonicalUrl} />}

    {/* Alternate language links (SEO) */}
    {meta.alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}

    {/* RSS discovery */}
    {meta.rssUrl && (
      <link rel="alternate" type="application/rss+xml" title={blogConfig.name} href={meta.rssUrl} />
    )}

    {favicon && (
      <link rel="icon" href={/^(https?:)?\/\//.test(favicon) ? favicon : `${basePrefix}${favicon}`} />
    )}

    {/* JSON-LD structured data */}
    <script type="application/ld+json" set:html={JSON.stringify(meta.jsonLd)} />

    {/* Color overrides from blog.json */}
    {meta.colorOverrides && <style set:html={meta.colorOverrides} />}

    {/* Dark mode init — prevent flash of unstyled content (FOUC) */}
    <script is:inline>
      ;(function () {
        var stored = localStorage.getItem('theme')
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark')
        }
        window.__toggleTheme = function () {
          var html = document.documentElement
          var isDark = html.classList.toggle('dark')
          localStorage.setItem('theme', isDark ? 'dark' : 'light')
        }
      })()
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
